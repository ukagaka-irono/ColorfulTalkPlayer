{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ColorfulTalkPlayer",
  "version": "1.0.0",
  "identifier": "io.github.ukagaka-irono.colorfultalkplayer",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ColorfulTalkPlayer",
        "width": 1120,
        "height": 820,
        "minWidth": 380,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "ColorfulTalk の読み上げアプリ",
    "longDescription": "無料の日本語音声合成 ColorfulTalk（V3 / V2 / V1 / nano）と言語処理エンジン ColorfulYomi を使った読み上げアプリです。"
  }
}
